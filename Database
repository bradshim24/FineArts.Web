CREATE PROCEDURE [dbo].[CreateGroupEvent]
    @GroupID INT,
    @CategoryID INT
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @EventID INT;
    DECLARE @RoomNumber VARCHAR(50);

    -- Step 1: Check if an event already exists for this group + category
    SELECT @EventID = EventID
    FROM ParticipationEvents
    WHERE GroupID = @GroupID
      AND CategoryID = @CategoryID;

    -- Step 2: If no event exists, create one
    IF @EventID IS NULL
    BEGIN
        -- Look up the room assigned to this category
        SELECT TOP 1 @RoomNumber = RoomNumber
        FROM EventRooms
        WHERE CategoryID = @CategoryID;

        -- If no room is assigned, fall back to 'TBD'
        IF @RoomNumber IS NULL
            SET @RoomNumber = 'TBD';

        INSERT INTO ParticipationEvents (RoomNumber, GroupID, CategoryID, Time)
        VALUES (@RoomNumber, @GroupID, @CategoryID, NULL);

        SET @EventID = SCOPE_IDENTITY();
    END

    -- Step 3: Store this EventID on the Groups table
    UPDATE Groups
    SET EventID = @EventID
    WHERE GroupID = @GroupID;

    -- Step 4: Return the EventID
    SELECT @EventID AS EventID;
END;
GO
