CREATE PROCEDURE [dbo].[CreateSoloEvent]
    @ParticipantID INT,
    @CategoryID INT
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @EventID INT;
    DECLARE @RoomNumber VARCHAR(50);

    -- Step 1: Check if an event already exists for this participant + category
    SELECT @EventID = EventID
    FROM ParticipationEvents
    WHERE ParticipantID = @ParticipantID
      AND CategoryID = @CategoryID;

    -- Step 2: If no event exists, create one
    IF @EventID IS NULL
    BEGIN
        -- Look up the room assigned to this category
        SELECT TOP 1 @RoomNumber = RoomNumber
        FROM EventRooms
        WHERE CategoryID = @CategoryID;

        -- If no room is assigned, fall back to 'TBD'
        IF @RoomNumber IS NULL
            SET @RoomNumber = 'TBD';

        INSERT INTO ParticipationEvents (RoomNumber, ParticipantID, CategoryID, Time)
        VALUES (@RoomNumber, @ParticipantID, @CategoryID, NULL);

        SET @EventID = SCOPE_IDENTITY();
    END

    -- Step 3: Store this EventID in ParticipantCategoryMap
    UPDATE ParticipantCategoryMap
    SET EventID = @EventID
    WHERE ParticipantID = @ParticipantID
      AND CategoryID = @CategoryID;

    -- Step 4: Return the EventID
    SELECT @EventID AS EventID;
END;
