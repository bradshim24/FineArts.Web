CREATE FUNCTION [dbo].[fn_CalculateTotalScore] ( @EvaluatorID INT, @EventID INT ) 
RETURNS INT AS BEGIN DECLARE @TotalScore INT; SELECT @TotalScore = ISNULL(SUM(ScoreValue), 
0) FROM EvaluatorEvents WHERE EvaluatorID = @EvaluatorID AND EventID = @EventID;

RETURN @TotalScore; 
END; 

